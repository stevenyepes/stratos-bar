# Maintainer: Steven Yepes
pkgname=stratos-bar
pkgver=0.2.0
pkgrel=1
pkgdesc="A sophisticated command palette for power users"
arch=('x86_64')
url="https://github.com/stevenyepes/stratos-bar"
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'libappindicator-gtk3' 'openssl' 'gst-plugins-base-libs' 'gst-plugins-good' 'gst-plugins-bad' 'gst-plugins-ugly' 'gst-libav')
optdepends=(
    'wmctrl: Window management support for X11'
    'wlrctl: Window management support for generic Wayland'
    'hyprland: Native window management support'
)
makedepends=('npm' 'cargo' 'nodejs' 'git')
# Deliberately fragment-less: this builds whatever the surrounding checkout has
# at HEAD, which is what both a local build and a CI run want. Do not pin
# `#branch=master` here -- makepkg resolves a branch fragment to `origin/<name>`
# in its working copy, and the detached checkout actions/checkout produces for a
# pull_request has no local branches to mirror, so the build dies on
# `fatal: invalid reference: origin/master`.
#
# The cost of no fragment is that the checkout follows refs/remotes/origin/HEAD,
# which git writes once at clone time and no later fetch updates, so a *reused*
# working copy can keep building a long-dead branch. Nothing here can fix that;
# install.sh removes the cached clone before every build so one never persists.
source=("${pkgname}::git+file://${startdir}/../../")
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/$pkgname"
    # Prefer git tag (v0.1.2), fall back to package.json if HEAD has no tag.
    # Assign first: in a pipeline the exit status is sed's, so `||` would never
    # fire and pkgver would silently come out empty.
    local tag
    tag=$(git describe --tags --abbrev=0 2>/dev/null | sed 's/^v//')
    if [ -n "$tag" ]; then
        printf '%s\n' "$tag"
    else
        node -p "require('./package.json').version"
    fi
}

prepare() {
    cd "$srcdir/$pkgname"
    # Reproducible: install exactly what's in the lockfile, not the latest.
    npm ci
}

build() {
    cd "$srcdir/$pkgname"
    # --no-bundle: skip AppImage/RPM/Deb bundling. We extract the binary directly
    # in package() and bundling adds minutes + an AppImage linuxdeploy failure
    # without NO_STRIP=true (see BUILD.md).
    npm run tauri -- build --no-bundle
}

check() {
    cd "$srcdir/$pkgname"
    cargo test --manifest-path src-tauri/Cargo.toml
    npm run test -- --run
}

package() {
    cd "$srcdir/$pkgname"

    # cargo (and the tauri CLI) write to $CARGO_TARGET_DIR when it is set;
    # CI points it outside $srcdir so the compiled deps survive between runs.
    local target="${CARGO_TARGET_DIR:-src-tauri/target}"

    # Binary
    install -Dm755 "$target/release/stratos-bar" "$pkgdir/usr/bin/stratos-bar"

    # Icons (Tauri generates these from the source SVG; sizes match hicolor spec)
    for size in 32 128; do
        install -Dm644 "src-tauri/icons/${size}x${size}.png" \
            "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/stratos-bar.png"
    done
    install -Dm644 "src-tauri/icons/128x128@2x.png" \
        "$pkgdir/usr/share/icons/hicolor/256x256/apps/stratos-bar.png"
    install -Dm644 "src-tauri/icons/icon.png" \
        "$pkgdir/usr/share/icons/hicolor/512x512/apps/stratos-bar.png"

    # Desktop entry from a single repo-level source of truth
    install -Dm644 "${startdir}/../stratos-bar.desktop" \
        "$pkgdir/usr/share/applications/stratos-bar.desktop"

    # License
    install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE" \
        2>/dev/null || true
}
